function [new_path] = smooth_path(old_path)
%SMOOTH_PATH Summary of this function goes here
%podle přednášky
% y_i^(k+1) = y_i + alpha*(x_i - y_i) + beta*(y_(i-1) + y_(i+1) - 2*y_i)
new_path = old_path;

X = old_path; 
Y = new_path;
alpha = 0.7;
%alpha = 0.15; %jak moc se má držet cesty
beta = 0.35; %jak moc má vyhlazovat
tolerance = 1e-4;
max_iterations = 500;

for k=1:max_iterations
    total_change = 0;
    for i=2:size(X,1)-1
        y_old=Y(i,:);

        Y(i,:) = Y(i,:)+alpha*(X(i,:)-Y(i,:))+beta*(Y(i-1,:)+Y(i+1,:)-2*Y(i,:));

        total_change = total_change+norm(Y(i,:) - y_old);
    end
    if total_change<tolerance
        break
    end
end
new_path=Y;


end

