function [weights] = weight_particles(particle_measurements, lidar_distances)
%WEIGHT_PARTICLES Summary of this function goes here

N = size(particle_measurements, 1);
weights = zeros(N,1);
sigma = 0.6; %zde si vytváříme proměnou pro porovnání lidaru


for i = 1:N
    pred=particle_measurements(i,:);
    real=lidar_distances;
    valid=isfinite(real) & isfinite(pred);

    if sum(vali)<3
        weights(i)=1e-12;
    else
        diff=pred(valid)-real()
        weights(i)=exp(-mse/(2*sigma^2));



    diff = particle_measurements(i,valid) - lidar_distances(valid);
    err2 = sum(diff.^2);
    mse = mean(diff.^2);

    weights(i)=exp(-err2/(2*sigma^2));
end

weights = weights + 1e-12;   % ochrana proti nulam
weights = weights / sum(weights);


end

