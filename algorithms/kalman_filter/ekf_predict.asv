function [new_mu, new_sigma] = ekf_predict(mu, sigma, u, kf, sampling_period)
%EKF_PREDICT Summary of this function goes here
%u = řízení
%mu = stav

x=mu(1);
y=mu(2);
theta=mu(3);

vR=u(1);
vL=u(2);

L=0.2;

v=(vR+vL)/2;
omega(vR-vL)/L;

x_new =x+v*cos(theta)*dt;
y_new=y+v*sin(theta)*dt;
theta_new=theta+omega*dt;

theta_new=atan2(sin(theta_new),cos(theta_new));
mu=[x_new;y_new;theta_new];

%Jakobián
G=1,0,-v*sin(theta)*dt;









new_mu = mu;
new_sigma = sigma;

end

