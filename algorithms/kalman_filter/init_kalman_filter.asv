function [public_vars] = init_kalman_filter(read_only_vars, public_vars)
%INIT_KALMAN_FILTER Summary of this function goes here

public_vars.kf.C = [
    1 0 0; 
    0 1 0];
public_vars.kf.R = [
    0.01 0 0;
    0 0.01 0;
    0 0 0.01];

public_vars.kf.Q = [
    0.5 0;
    0 0.5];


%Inicializace sběru dat pro určení počáteční polohy z GNSS
public_vars.kf.init_samples_needed = 80;
public_vars.kf.init_samples = [];
public_vars.kf.init_done=false;

%public_vars.mu = [2;2;pi/2];
public_vars.sigma = zeros(3,3);

disp("Inicializace sběru dat počáteční polohy")

end

