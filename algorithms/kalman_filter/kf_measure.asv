function [new_mu, new_sigma] = kf_measure(mu, sigma, z, kf)
%KF_MEASURE Summary of this function goes here

z=z(:);%skutečné GNSS měření
C=kf.C;%měřící matice ( v prezentaci Ht)
Q=kf.Q;%matice šumu GNSS

S=C*sigma*C'+Q; %inovační kovariance
K=sigma*C'*inv(S); %Kalman gain


innovation = z-C*mu; %rozdíl mezi skutečným měřeným GNSS a očekávaným odhadem GNSS
mu=mu+K*innovation;%korekce odhadu stavu



I=eye(size(sigma));
sigma=(I-K*C)*sigma; %korekce nejistoty
sigma = (sigma+sigma')/2;



mu(3)=atan2(sin(mu(3)),cos(mu(3)));





% new_mu = mu;
% new_sigma = sigma;

end

